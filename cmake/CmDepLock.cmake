# Lockfile and transitive dependency resolution.
#
#   cmdep lock    resolve the whole dependency graph into cmdep.lock
#   cmdep tree    show it
#
# Resolution reads the root packages file and, for every package it resolves,
# that package's own packages file (found by convention inside its source:
# cmdep-packages.cmake, CMake/3rdPartyPackages.cmake, cmake/3rdPartyPackages.cmake,
# cmake/packages.cmake, CMake/packages.cmake), repeatedly, until nothing changes.
# For each package name:
#   - a root declaration always wins;
#   - otherwise the highest version requested by any resolved package wins;
#   - two requests for the same version with different hashes are an error.
# Only requests from the *resolved* version of a package count, so switching a
# package's version also switches whose requirements apply.
#
# The lockfile is plain CMake (CmDepLocked(...) calls), loaded by the root
# CmDepFetch(): root declarations are checked against it, and the transitive
# packages it lists are fetched and registered so every dependency that
# declares them gets the locked copy (see the registry in CmDepFetch.cmake).
#
# Declarations are collected with the packages files evaluated in script mode,
# so declarations guarded by options are only seen if those options are set
# (`cmdep lock -DMYPROJ_BUILD_TESTS=ON`).

# Policies for cmake-dep's own code, so it behaves the same in a configure and
# in a bare `cmake -P` (include() keeps this from leaking into the includer).
cmake_policy(VERSION 3.18)

# Version comparison: compares the leading numeric part ("v1.51.0" -> 1.51.0)
# with VERSION_GREATER, falling back to a string comparison.
function(_CmDepVersionGreater out_var a b)
    # (REGEX MATCH, not REPLACE: CMake rejects REPLACE patterns that can match "")
    string(REGEX MATCH "[0-9]+(\\.[0-9]+)*" _na "${a}")
    string(REGEX MATCH "[0-9]+(\\.[0-9]+)*" _nb "${b}")
    if (_na AND _nb AND NOT _na STREQUAL _nb)
        if (_na VERSION_GREATER _nb)
            set(${out_var} TRUE PARENT_SCOPE)
        else ()
            set(${out_var} FALSE PARENT_SCOPE)
        endif ()
    elseif (a STRGREATER b)
        set(${out_var} TRUE PARENT_SCOPE)
    else ()
        set(${out_var} FALSE PARENT_SCOPE)
    endif ()
endfunction()

# ---------------------------------------------------------------------------
# Collection (CmDepFetchPackage/CmDepFetchGit while CMDEP_COLLECTING is set)
# ---------------------------------------------------------------------------
function(_CmDepCollect kind name version locator second)
    cmake_parse_arguments(PARSE_ARGV 5 _C "" "" "PATCHES")
    if (kind STREQUAL "ARCHIVE")
        set(_url "${locator}")
        set(_repo "")
        set(_commit "")
        set(_hash "${second}")
        if (NOT _hash MATCHES "^[^=]+=[0-9a-fA-F]+$")
            message(FATAL_ERROR "cmake-dep: hash for '${name}' must be ALGO=HEX, got '${_hash}'")
        endif ()
    else ()
        set(_url "")
        set(_repo "${locator}")
        string(TOLOWER "${second}" _commit)
        _CmDepCheckCommit(${name} "${_commit}")
        set(_hash "")
        foreach (_a IN LISTS _C_UNPARSED_ARGUMENTS)
            if (_a MATCHES "^[A-Za-z0-9_]+=[0-9a-fA-F]+$")
                set(_hash "${_a}")
            endif ()
        endforeach ()
        if (_hash STREQUAL "")
            _CmDepGitArchiveHash(_hex ${name} "${_repo}" "${_commit}")
            set(_hash "SHA256=${_hex}")
        endif ()
    endif ()
    string(REGEX MATCH "^([^=]+)=(.*)$" _m "${_hash}")
    string(TOUPPER "${CMAKE_MATCH_1}" _algo)
    string(TOLOWER "${CMAKE_MATCH_2}" _hex)
    set(_hash "${_algo}=${_hex}")

    get_property(_declarer GLOBAL PROPERTY CMDEP_LK_DECLARER)
    get_property(_dkey GLOBAL PROPERTY CMDEP_LK_DKEY)
    get_property(_filerel GLOBAL PROPERTY CMDEP_LK_FILEREL)
    get_property(_n GLOBAL PROPERTY CMDEP_LK_COUNT)
    if (NOT _n)
        set(_n 0)
    endif ()
    math(EXPR _n "${_n} + 1")
    set_property(GLOBAL PROPERTY CMDEP_LK_COUNT ${_n})
    set(_id "c${_n}")
    foreach (_f NAME KIND VERSION URL REPO COMMIT HASH DECLARER DKEY FILEREL)
        if (_f STREQUAL "NAME")
            set(_v "${name}")
        elseif (_f STREQUAL "KIND")
            set(_v "${kind}")
        elseif (_f STREQUAL "VERSION")
            set(_v "${version}")
        elseif (_f STREQUAL "URL")
            set(_v "${_url}")
        elseif (_f STREQUAL "REPO")
            set(_v "${_repo}")
        elseif (_f STREQUAL "COMMIT")
            set(_v "${_commit}")
        elseif (_f STREQUAL "HASH")
            set(_v "${_hash}")
        elseif (_f STREQUAL "DECLARER")
            set(_v "${_declarer}")
        elseif (_f STREQUAL "DKEY")
            set(_v "${_dkey}")
        elseif (_f STREQUAL "FILEREL")
            set(_v "${_filerel}")
        endif ()
        set_property(GLOBAL PROPERTY CMDEP_LK_C_${_id}_${_f} "${_v}")
    endforeach ()
    set_property(GLOBAL PROPERTY CMDEP_LK_C_${_id}_PATCHES "${_C_PATCHES}")
    set_property(GLOBAL APPEND PROPERTY CMDEP_LK_CANDS_${name} ${_id})
    get_property(_names GLOBAL PROPERTY CMDEP_LK_NAMES)
    list(FIND _names "${name}" _i)
    if (_i EQUAL -1)
        set_property(GLOBAL APPEND PROPERTY CMDEP_LK_NAMES "${name}")
    endif ()
endfunction()

function(_CmDepFindPackagesFileIn out_var dir)
    set(_f "")
    foreach (_c cmdep-packages.cmake CMake/3rdPartyPackages.cmake cmake/3rdPartyPackages.cmake
                cmake/packages.cmake CMake/packages.cmake)
        if (EXISTS "${dir}/${_c}")
            set(_f "${_c}")
            break()
        endif ()
    endforeach ()
    set(${out_var} "${_f}" PARENT_SCOPE)
endfunction()

# Populates a (locked or candidate) package, applying its patches relative to
# the packages file that declared it. Sets out_var to its source dir.
function(_CmDepPopulateDeclared out_var name kind version url repo commit hash patches declarer filerel root_dir src_of_declarer)
    if (kind STREQUAL "GIT")
        _CmDepPopulate(_src ${name} "${version}" "git+${repo}#${commit}" "${hash}")
    else ()
        _CmDepPopulate(_src ${name} "${version}" "${url}" "${hash}")
    endif ()
    if (patches AND NOT CMDEP_MIRROR_OUT)
        if (declarer STREQUAL ".")
            set(_base "${root_dir}")
        else ()
            get_filename_component(_reldir "${filerel}" DIRECTORY)
            set(_base "${src_of_declarer}/${_reldir}")
        endif ()
        set(_abs "")
        foreach (_p IN LISTS patches)
            get_filename_component(_p "${_p}" ABSOLUTE BASE_DIR "${_base}")
            list(APPEND _abs "${_p}")
        endforeach ()
        _CmDepPatch(_src ${name} "${_src}" ${_abs})
    endif ()
    set(${out_var} "${_src}" PARENT_SCOPE)
endfunction()

function(_CmDepCandField out_var id field)
    get_property(_v GLOBAL PROPERTY CMDEP_LK_C_${id}_${field})
    set(${out_var} "${_v}" PARENT_SCOPE)
endfunction()

# Fetches the resolved candidate of <name> and collects its own declarations.
function(_CmDepLockExpand name id)
    foreach (_f KIND VERSION URL REPO COMMIT HASH PATCHES DECLARER FILEREL)
        _CmDepCandField(_${_f} ${id} ${_f})
    endforeach ()
    get_property(_root_dir GLOBAL PROPERTY CMDEP_LK_ROOT_DIR)
    set(_dsrc "")
    if (NOT _DECLARER STREQUAL ".")
        get_property(_dsrc GLOBAL PROPERTY CMDEP_LK_SRC_${_DECLARER})
    endif ()
    _CmDepPopulateDeclared(_src ${name} "${_KIND}" "${_VERSION}" "${_URL}" "${_REPO}" "${_COMMIT}"
        "${_HASH}" "${_PATCHES}" "${_DECLARER}" "${_FILEREL}" "${_root_dir}" "${_dsrc}")
    set_property(GLOBAL PROPERTY CMDEP_LK_SRC_${name} "${_src}")
    _CmDepFindPackagesFileIn(_pf "${_src}")
    if (_pf)
        message(STATUS "cmake-dep: lock: reading ${name}'s ${_pf}")
        set_property(GLOBAL PROPERTY CMDEP_LK_DECLARER "${name}")
        set_property(GLOBAL PROPERTY CMDEP_LK_DKEY "${name}@${_HASH}")
        set_property(GLOBAL PROPERTY CMDEP_LK_FILEREL "${_pf}")
        include("${_src}/${_pf}")
    endif ()
endfunction()

# Candidates of <name> whose declarer is the root or the resolved version of a package.
function(_CmDepActiveCandidates out_var name)
    get_property(_cands GLOBAL PROPERTY CMDEP_LK_CANDS_${name})
    set(_active "")
    foreach (_id IN LISTS _cands)
        _CmDepCandField(_dkey ${_id} DKEY)
        if (_dkey STREQUAL ".")
            list(APPEND _active ${_id})
        else ()
            string(REGEX MATCH "^(.*)@(.*)$" _m "${_dkey}")
            set(_dname "${CMAKE_MATCH_1}")
            set(_dhash "${CMAKE_MATCH_2}")
            get_property(_rh GLOBAL PROPERTY CMDEP_LK_RHASH_${_dname})
            if (_rh STREQUAL _dhash)
                list(APPEND _active ${_id})
            endif ()
        endif ()
    endforeach ()
    set(${out_var} "${_active}" PARENT_SCOPE)
endfunction()

function(_CmDepLockPick out_var name)
    _CmDepActiveCandidates(_active ${name})
    set(_pick "")
    foreach (_id IN LISTS _active)
        _CmDepCandField(_dkey ${_id} DKEY)
        if (_dkey STREQUAL ".")
            set(_pick ${_id})
            break()
        endif ()
    endforeach ()
    if (NOT _pick)
        foreach (_id IN LISTS _active)
            if (NOT _pick)
                set(_pick ${_id})
                continue()
            endif ()
            _CmDepCandField(_v ${_id} VERSION)
            _CmDepCandField(_h ${_id} HASH)
            _CmDepCandField(_pv ${_pick} VERSION)
            _CmDepCandField(_ph ${_pick} HASH)
            if (_v STREQUAL _pv AND NOT _h STREQUAL _ph)
                _CmDepCandField(_d1 ${_id} DECLARER)
                _CmDepCandField(_d2 ${_pick} DECLARER)
                message(FATAL_ERROR "cmake-dep: lock: conflict for ${name} ${_v}: ${_d1} pins ${_h} but "
                                    "${_d2} pins ${_ph}. Declare ${name} in the root packages file to decide.")
            endif ()
            _CmDepVersionGreater(_gt "${_v}" "${_pv}")
            if (_gt)
                set(_pick ${_id})
            endif ()
        endforeach ()
    endif ()
    set(${out_var} "${_pick}" PARENT_SCOPE)
endfunction()

# Resolves the graph rooted at <packages_file> and writes <lock_file>.
function(CmDepLockResolve packages_file lock_file)
    get_filename_component(_root_dir "${packages_file}" DIRECTORY)
    get_filename_component(_root_name "${packages_file}" NAME)
    set_property(GLOBAL PROPERTY CMDEP_LK_ROOT_DIR "${_root_dir}")
    set_property(GLOBAL PROPERTY CMDEP_COLLECTING TRUE)
    set_property(GLOBAL PROPERTY CMDEP_LK_DECLARER ".")
    set_property(GLOBAL PROPERTY CMDEP_LK_DKEY ".")
    set_property(GLOBAL PROPERTY CMDEP_LK_FILEREL "${_root_name}")
    include("${packages_file}")

    set(_expanded "")
    set(_round 0)
    while (TRUE)
        math(EXPR _round "${_round} + 1")
        if (_round GREATER 100)
            message(FATAL_ERROR "cmake-dep: lock: resolution does not converge")
        endif ()
        set(_changed FALSE)
        get_property(_names GLOBAL PROPERTY CMDEP_LK_NAMES)
        list(SORT _names)
        foreach (_name IN LISTS _names)
            _CmDepLockPick(_pick ${_name})
            get_property(_cur GLOBAL PROPERTY CMDEP_LK_R_${_name})
            if (NOT "${_pick}" STREQUAL "${_cur}")
                set(_changed TRUE)
                set_property(GLOBAL PROPERTY CMDEP_LK_R_${_name} "${_pick}")
                if (_pick)
                    _CmDepCandField(_h ${_pick} HASH)
                    set_property(GLOBAL PROPERTY CMDEP_LK_RHASH_${_name} "${_h}")
                else ()
                    set_property(GLOBAL PROPERTY CMDEP_LK_RHASH_${_name} "")
                endif ()
            endif ()
        endforeach ()
        foreach (_name IN LISTS _names)
            get_property(_pick GLOBAL PROPERTY CMDEP_LK_R_${_name})
            if (NOT _pick)
                continue()
            endif ()
            _CmDepCandField(_h ${_pick} HASH)
            list(FIND _expanded "${_name}@${_h}" _i)
            if (_i EQUAL -1)
                list(APPEND _expanded "${_name}@${_h}")
                _CmDepLockExpand(${_name} ${_pick})
                set(_changed TRUE)
            endif ()
        endforeach ()
        if (NOT _changed)
            break()
        endif ()
    endwhile ()
    set_property(GLOBAL PROPERTY CMDEP_COLLECTING FALSE)

    # Order: root declarations first, then breadth-first by declarer, so a
    # package's declarer is always fetched (and its patches available) first.
    get_property(_names GLOBAL PROPERTY CMDEP_LK_NAMES)
    list(SORT _names)
    set(_order "")
    set(_frontier ".")
    while (_frontier)
        set(_next "")
        foreach (_name IN LISTS _names)
            get_property(_pick GLOBAL PROPERTY CMDEP_LK_R_${_name})
            if (NOT _pick)
                continue()
            endif ()
            list(FIND _order "${_name}" _seen)
            if (NOT _seen EQUAL -1)
                continue()
            endif ()
            _CmDepCandField(_d ${_pick} DECLARER)
            list(FIND _frontier "${_d}" _i)
            if (NOT _i EQUAL -1)
                list(APPEND _order "${_name}")
                list(APPEND _next "${_name}")
            endif ()
        endforeach ()
        set(_frontier "${_next}")
    endwhile ()

    set(_out "# cmdep.lock -- generated by `cmdep lock` from ${_root_name}. Commit it; don't edit it.\n")
    string(APPEND _out "# Regenerate after changing a packages file: cmdep lock\n\n")
    string(APPEND _out "CmDepLockFormat(1)\n")
    set(_notes "")
    foreach (_name IN LISTS _order)
        get_property(_pick GLOBAL PROPERTY CMDEP_LK_R_${_name})
        foreach (_f KIND VERSION URL REPO COMMIT HASH PATCHES DECLARER FILEREL)
            _CmDepCandField(_${_f} ${_pick} ${_f})
        endforeach ()
        string(APPEND _out "\nCmDepLocked(${_name}\n    VERSION [==[${_VERSION}]==]\n")
        if (_KIND STREQUAL "GIT")
            string(APPEND _out "    GIT [==[${_REPO}]==]\n    COMMIT ${_COMMIT}\n")
        else ()
            string(APPEND _out "    URL [==[${_URL}]==]\n")
        endif ()
        string(APPEND _out "    HASH ${_HASH}\n    DECLARED_BY ${_DECLARER}\n")
        if (NOT _DECLARER STREQUAL ".")
            string(APPEND _out "    DECLARED_IN [==[${_FILEREL}]==]\n")
        endif ()
        if (_PATCHES)
            string(APPEND _out "    PATCHES")
            foreach (_p IN LISTS _PATCHES)
                string(APPEND _out " [==[${_p}]==]")
            endforeach ()
            string(APPEND _out "\n")
        endif ()
        _CmDepActiveCandidates(_active ${_name})
        string(APPEND _out "    REQUESTED_BY")
        foreach (_id IN LISTS _active)
            _CmDepCandField(_d ${_id} DECLARER)
            _CmDepCandField(_v ${_id} VERSION)
            string(APPEND _out " [==[${_d}=${_v}]==]")
            if (NOT _v STREQUAL _VERSION)
                string(APPEND _notes "  ${_name}: ${_d} asks for ${_v}, locked to ${_VERSION}\n")
            endif ()
        endforeach ()
        string(APPEND _out ")\n")
    endforeach ()
    file(WRITE "${lock_file}" "${_out}")
    list(LENGTH _order _n)
    set(_summary "cmake-dep: wrote ${lock_file} (${_n} packages)")
    if (_notes)
        string(APPEND _summary "\nunified versions:\n${_notes}")
    endif ()
    execute_process(COMMAND ${CMAKE_COMMAND} -E echo "${_summary}")
endfunction()

# ---------------------------------------------------------------------------
# Loading and applying (configure, cmdep fetch, cmdep mirror)
# ---------------------------------------------------------------------------
function(CmDepLockFormat version)
    if (NOT version EQUAL 1)
        message(FATAL_ERROR "cmake-dep: unsupported lockfile format ${version}; update cmake-dep")
    endif ()
endfunction()

function(CmDepLocked name)
    cmake_parse_arguments(PARSE_ARGV 1 _L "" "VERSION;URL;GIT;COMMIT;HASH;DECLARED_BY;DECLARED_IN"
        "PATCHES;REQUESTED_BY")
    foreach (_f VERSION URL GIT COMMIT HASH DECLARED_BY DECLARED_IN PATCHES REQUESTED_BY)
        set_property(GLOBAL PROPERTY CMDEP_LOCK_${name}_${_f} "${_L_${_f}}")
    endforeach ()
    set_property(GLOBAL APPEND PROPERTY CMDEP_LOCK_NAMES "${name}")
endfunction()

function(_CmDepLoadLock lock_file)
    set_property(GLOBAL PROPERTY CMDEP_LOCK_NAMES "")
    include("${lock_file}")
    set_property(GLOBAL PROPERTY CMDEP_LOCK_ACTIVE TRUE)
    set_property(GLOBAL PROPERTY CMDEP_LOCK_FILE_PATH "${lock_file}")
endfunction()

# Fetches every locked package the root did not declare itself and registers it,
# so dependencies that declare it get the locked copy. The root project's
# <PREFIX>_USE_SYSTEM_<DEP> knob works for these transitive packages too.
function(_CmDepApplyLock root_dir)
    get_property(_names GLOBAL PROPERTY CMDEP_LOCK_NAMES)
    _CmDepProjectPrefix(_prefix)
    get_property(_lock_file GLOBAL PROPERTY CMDEP_LOCK_FILE_PATH)
    get_filename_component(_lock_name "${_lock_file}" NAME)
    foreach (_name IN LISTS _names)
        get_property(_by GLOBAL PROPERTY CMDEP_LOCK_${_name}_DECLARED_BY)
        _CmDepRegistryGet(${_name} _found)
        if (_found OR _by STREQUAL ".")
            continue()  # the root decides about its own declarations
        endif ()
        foreach (_f VERSION URL GIT COMMIT HASH DECLARED_IN PATCHES)
            get_property(_${_f} GLOBAL PROPERTY CMDEP_LOCK_${_name}_${_f})
        endforeach ()
        string(TOUPPER "${_name}" _dep)
        string(MAKE_C_IDENTIFIER "${_dep}" _dep)
        option(${_prefix}_USE_SYSTEM_${_dep} "Use a system-installed ${_name} instead of fetching" OFF)
        if (${_prefix}_USE_SYSTEM_${_dep})
            _CmDepRegistrySet(${_name} "" "${_VERSION}" "${_HASH}" ON "${_lock_name}")
            continue()
        endif ()
        if (_GIT)
            set(_kind GIT)
        else ()
            set(_kind ARCHIVE)
        endif ()
        get_property(_dsrc GLOBAL PROPERTY CMDEP_REG_${_by}_SOURCE_DIR)
        _CmDepPopulateDeclared(_src ${_name} ${_kind} "${_VERSION}" "${_URL}" "${_GIT}" "${_COMMIT}"
            "${_HASH}" "${_PATCHES}" "${_by}" "${_DECLARED_IN}" "${root_dir}" "${_dsrc}")
        _CmDepRegistrySet(${_name} "${_src}" "${_VERSION}" "${_HASH}" OFF "${_lock_name}, via ${_by}")
    endforeach ()
endfunction()

# Prints the locked graph as a tree.
function(CmDepLockTree lock_file root_label)
    _CmDepLoadLock("${lock_file}")
    get_property(_names GLOBAL PROPERTY CMDEP_LOCK_NAMES)
    foreach (_name IN LISTS _names)
        get_property(_reqs GLOBAL PROPERTY CMDEP_LOCK_${_name}_REQUESTED_BY)
        foreach (_r IN LISTS _reqs)
            string(REGEX MATCH "^(.*)=(.*)$" _m "${_r}")
            set_property(GLOBAL APPEND PROPERTY CMDEP_TREE_CHILDREN_${CMAKE_MATCH_1} "${_name}")
            set_property(GLOBAL PROPERTY CMDEP_TREE_WANT_${CMAKE_MATCH_1}_${_name} "${CMAKE_MATCH_2}")
        endforeach ()
    endforeach ()
    set_property(GLOBAL PROPERTY CMDEP_TREE_OUT "${root_label}\n")
    _CmDepTreeWalk("." "" ".")
    get_property(_out GLOBAL PROPERTY CMDEP_TREE_OUT)
    execute_process(COMMAND ${CMAKE_COMMAND} -E echo "${_out}")
endfunction()

function(_CmDepTreeWalk node indent path)
    get_property(_kids GLOBAL PROPERTY CMDEP_TREE_CHILDREN_${node})
    list(LENGTH _kids _n)
    set(_i 0)
    foreach (_k IN LISTS _kids)
        math(EXPR _i "${_i} + 1")
        if (_i EQUAL _n)
            set(_branch "`-- ")
            set(_cont "    ")
        else ()
            set(_branch "|-- ")
            set(_cont "|   ")
        endif ()
        get_property(_v GLOBAL PROPERTY CMDEP_LOCK_${_k}_VERSION)
        get_property(_want GLOBAL PROPERTY CMDEP_TREE_WANT_${node}_${_k})
        set(_line "${indent}${_branch}${_k} ${_v}")
        if (NOT _want STREQUAL _v)
            string(APPEND _line " (asks for ${_want})")
        endif ()
        list(FIND path "${_k}" _cycle)
        if (NOT _cycle EQUAL -1)
            string(APPEND _line " (cycle)")
        endif ()
        set_property(GLOBAL APPEND_STRING PROPERTY CMDEP_TREE_OUT "${_line}\n")
        if (_cycle EQUAL -1)
            _CmDepTreeWalk("${_k}" "${indent}${_cont}" "${path};${_k}")
        endif ()
    endforeach ()
endfunction()
