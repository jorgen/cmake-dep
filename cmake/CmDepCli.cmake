# The `cmdep` command line. Run through bin/cmdep (or bin/cmdep.cmd on Windows),
# which call:  cmake -P CmDepCli.cmake -- <command> [args...]
#
# Everything is plain CMake script, so cmdep needs nothing but CMake.

# Policies for cmake-dep's own code, so it behaves the same in a configure and
# in a bare `cmake -P` (include() keeps this from leaking into the includer).
cmake_policy(VERSION 3.18)


include("${CMAKE_CURRENT_LIST_DIR}/CmDepFetch.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/CmDepCache.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/CmDepBinary.cmake")
set(_CMDEP_CLI_DIR "${CMAKE_CURRENT_LIST_DIR}")

function(_CmDepOut text)
    execute_process(COMMAND ${CMAKE_COMMAND} -E echo "${text}")
endfunction()

function(_CmDepUsage)
    _CmDepOut("usage: cmdep [global options] <command> [args]

Dependencies
  add <name> <version> <url>       download <url>, hash it, append it to the packages file
  hash <url-or-file>               print the ALGO=HEX hash line for an archive
  fetch                            download everything in the packages file (no configure)
  lock                             resolve the whole dependency graph into cmdep.lock
  tree                             show the locked dependency graph

Mirrors and binaries
  mirror <out>                     copy every pinned archive into a mirror (dir or URL)
  push-binary <entry> <target>     upload a binary package from the local cache
  keygen <file>                    create a signing key for binary packages

Cache
  status                           list cache entries, sizes and last use
  gc                               remove unused entries (default: unused for 90 days)
  verify                           re-hash archives, report incomplete entries
  cache-dir                        print the cache directory

Global options
  --packages <file>   packages file (default: $CMDEP_PACKAGES_FILE, then
                      cmdep-packages.cmake, CMake/3rdPartyPackages.cmake, ... in cwd)
  --cache-dir <dir>   cache directory (same as CMDEP_DIR)
  --project <prefix>  knob prefix, so -D<PREFIX>_<DEP>_URL/_SHA256 overrides apply
  -D<VAR>=<VALUE>     set any cmake-dep setting (CMDEP_MIRRORS, ...)

Command options
  add/hash: --algo <ALGO> (default SHA256)   add: --git <commit> (url is a git repo)
  gc: --older-than <30d|12h|2w> --max-size <20G|500M> --dry-run   verify: --dry-run

Docs: https://github.com/jorgen/cmake-dep (docs/)")
endfunction()

# Default packages file: --packages, $CMDEP_PACKAGES_FILE, else the first
# conventional name that exists in the current directory.
function(_CmDepFindPackagesFile out_var)
    if (_cli_packages)
        set(_f "${_cli_packages}")
    elseif (DEFINED ENV{CMDEP_PACKAGES_FILE} AND NOT "$ENV{CMDEP_PACKAGES_FILE}" STREQUAL "")
        set(_f "$ENV{CMDEP_PACKAGES_FILE}")
    else ()
        set(_f "")
        foreach (_c cmdep-packages.cmake CMake/3rdPartyPackages.cmake cmake/3rdPartyPackages.cmake
                    cmake/packages.cmake CMake/packages.cmake)
            if (EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/${_c}")
                set(_f "${CMAKE_CURRENT_SOURCE_DIR}/${_c}")
                break()
            endif ()
        endforeach ()
    endif ()
    if (_f)
        get_filename_component(_f "${_f}" ABSOLUTE)
    endif ()
    set(${out_var} "${_f}" PARENT_SCOPE)
endfunction()

function(_CmDepRequirePackagesFile out_var)
    _CmDepFindPackagesFile(_f)
    if (NOT _f OR NOT EXISTS "${_f}")
        message(FATAL_ERROR "cmdep: no packages file found; pass --packages <file> "
                            "(or create cmdep-packages.cmake, e.g. with `cmdep add`)")
    endif ()
    set(${out_var} "${_f}" PARENT_SCOPE)
endfunction()

# Downloads <location> (URL or local file), hashes it, keeps it in the archive
# store, and returns the hex digest. Note: the hash is of whatever was
# downloaded -- compare it with the checksum the project publishes.
function(_CmDepHashLocation out_hex location algo)
    CmDepCacheDir(_root)
    file(MAKE_DIRECTORY "${_root}/.tmp")
    string(RANDOM LENGTH 10 _r)
    set(_tmp "${_root}/.tmp/hash-${_r}")
    if (EXISTS "${location}")
        get_filename_component(_abs "${location}" ABSOLUTE)
        execute_process(COMMAND ${CMAKE_COMMAND} -E copy "${_abs}" "${_tmp}" RESULT_VARIABLE _rc)
        if (NOT _rc EQUAL 0)
            message(FATAL_ERROR "cmdep: cannot read ${location}")
        endif ()
    else ()
        message(STATUS "cmdep: downloading ${location}")
        file(DOWNLOAD "${location}" "${_tmp}" STATUS _s)
        list(GET _s 0 _code)
        if (NOT _code EQUAL 0)
            list(GET _s 1 _msg)
            file(REMOVE "${_tmp}")
            message(FATAL_ERROR "cmdep: download failed (${location}): ${_msg}")
        endif ()
    endif ()
    file(${algo} "${_tmp}" _hex)
    _CmDepSetting(_keep CMDEP_KEEP_ARCHIVES ON)
    string(TOLOWER "${algo}" _adir)
    if (_keep AND NOT EXISTS "${_root}/archives/${_adir}/${_hex}")
        _CmDepPublishBlob(_ok "${_tmp}" "${_root}/archives/${_adir}/${_hex}" MOVE)
    endif ()
    file(REMOVE "${_tmp}")
    set(${out_hex} "${_hex}" PARENT_SCOPE)
endfunction()

# Resolves a tag/branch to a commit id with `git ls-remote` (annotated tags are
# peeled to the commit they point at). A full commit id is returned as is.
function(_CmDepResolveGitRef out_var repo ref)
    string(TOLOWER "${ref}" _lower)
    string(LENGTH "${_lower}" _len)
    if (_lower MATCHES "^[0-9a-f]+$" AND (_len EQUAL 40 OR _len EQUAL 64))
        set(${out_var} "${_lower}" PARENT_SCOPE)
        return()
    endif ()
    find_program(CMDEP_GIT_EXECUTABLE NAMES git)
    if (NOT CMDEP_GIT_EXECUTABLE)
        message(FATAL_ERROR "cmdep: git not found")
    endif ()
    execute_process(COMMAND ${CMAKE_COMMAND} -E env GIT_TERMINAL_PROMPT=0
            "${CMDEP_GIT_EXECUTABLE}" ls-remote "${repo}" "${ref}" "${ref}^{}"
        RESULT_VARIABLE _r OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
    if (NOT _r EQUAL 0)
        message(FATAL_ERROR "cmdep: git ls-remote ${repo} failed: ${_err}")
    endif ()
    set(_commit "")
    set(_peeled "")
    string(REPLACE "\n" ";" _lines "${_out}")
    foreach (_l IN LISTS _lines)
        if (_l MATCHES "^([0-9a-f]+)[ \t]+(.*)$")
            set(_sha "${CMAKE_MATCH_1}")    # save: the next MATCHES resets CMAKE_MATCH_*
            set(_refname "${CMAKE_MATCH_2}")
            if (_refname MATCHES "\\^\\{\\}$")
                set(_peeled "${_sha}")
            elseif (NOT _commit)
                set(_commit "${_sha}")
            endif ()
        endif ()
    endforeach ()
    if (_peeled)
        set(_commit "${_peeled}")
    endif ()
    if (NOT _commit)
        message(FATAL_ERROR "cmdep: '${ref}' not found in ${repo}")
    endif ()
    set(${out_var} "${_commit}" PARENT_SCOPE)
endfunction()

function(_CmDepCliAdd)
    if (NOT _cli_args_count EQUAL 3)
        message(FATAL_ERROR "usage: cmdep add <name> <version> <url> [--algo SHA256] [--git <commit>]")
    endif ()
    list(GET _cli_args 0 _name)
    list(GET _cli_args 1 _version)
    list(GET _cli_args 2 _url)
    _CmDepFindPackagesFile(_file)
    if (NOT _file)
        set(_file "${CMAKE_CURRENT_SOURCE_DIR}/cmdep-packages.cmake")
    endif ()
    if (EXISTS "${_file}")
        file(READ "${_file}" _existing)
        if (_existing MATCHES "CmDepFetch(Package|Git)\\([ \t\r\n]*${_name}[ \t\r\n]")
            message(FATAL_ERROR "cmdep: '${_name}' is already declared in ${_file}")
        endif ()
    else ()
        file(WRITE "${_file}" "# cmake-dep packages file (see https://github.com/jorgen/cmake-dep)\n")
    endif ()
    if (_cli_git)
        _CmDepResolveGitRef(_commit "${_url}" "${_cli_git}")
        _CmDepGitArchiveHash(_hex ${_name} "${_url}" "${_commit}")
        set(_line "\nCmDepFetchGit(${_name} ${_version}\n    ${_url}\n    ${_commit}  # ${_cli_git}\n    SHA256=${_hex})\n")
    else ()
        _CmDepHashLocation(_hex "${_url}" ${_cli_algo})
        set(_line "\nCmDepFetchPackage(${_name} ${_version}\n    ${_url}\n    ${_cli_algo}=${_hex})\n")
    endif ()
    file(APPEND "${_file}" "${_line}")
    _CmDepOut("added ${_name} ${_version} to ${_file}:${_line}")
    if (NOT _cli_git)
        _CmDepOut("Check the hash against the checksum ${_name} publishes, if it publishes one: the hash
pins whatever was downloaded just now.")
    endif ()
endfunction()

function(_CmDepCliHash)
    if (NOT _cli_args_count EQUAL 1)
        message(FATAL_ERROR "usage: cmdep hash <url-or-file> [--algo SHA256]")
    endif ()
    list(GET _cli_args 0 _loc)
    _CmDepHashLocation(_hex "${_loc}" ${_cli_algo})
    _CmDepOut("${_cli_algo}=${_hex}")
endfunction()

function(_CmDepCliFetch)
    _CmDepRequirePackagesFile(_file)
    include("${_CMDEP_CLI_DIR}/CmDepFetchDependencies.cmake")
    get_filename_component(_root "${_file}" DIRECTORY)
    CmDepFetchSetup("${CMAKE_CURRENT_SOURCE_DIR}" "${_file}")
endfunction()

function(_CmDepCliMirror)
    if (NOT _cli_args_count EQUAL 1)
        message(FATAL_ERROR "usage: cmdep mirror <dir-or-url> [--packages file]")
    endif ()
    _CmDepRequirePackagesFile(_file)
    list(GET _cli_args 0 _out)
    _CmDepLocalPath(_local "${_out}")
    if (_local AND NOT IS_ABSOLUTE "${_local}")
        get_filename_component(_out "${_local}" ABSOLUTE)
    endif ()
    set(CMDEP_MIRROR_OUT "${_out}")
    include("${_CMDEP_CLI_DIR}/CmDepMirror.cmake")
    CmDepMirrorPackages("${_file}")
endfunction()

function(_CmDepCliPushBinary)
    if (NOT _cli_args_count EQUAL 2)
        message(FATAL_ERROR "usage: cmdep push-binary <cache entry dir> <dir-or-url>")
    endif ()
    list(GET _cli_args 0 _entry)
    list(GET _cli_args 1 _target)
    execute_process(COMMAND ${CMAKE_COMMAND} ${_cli_defines}
        "-DCMDEP_BINARY_ENTRY=${_entry}" "-DCMDEP_BINARY_PUSH=${_target}"
        -P "${_CMDEP_CLI_DIR}/CmDepBinaryPush.cmake" RESULT_VARIABLE _rc)
    if (NOT _rc EQUAL 0)
        message(FATAL_ERROR "cmdep: push-binary failed")
    endif ()
endfunction()

# --- argument parsing -------------------------------------------------------
set(_cli_raw "")
set(_seen_dashdash FALSE)
math(EXPR _last "${CMAKE_ARGC} - 1")
foreach (_i RANGE 0 ${_last})
    if (_seen_dashdash)
        list(APPEND _cli_raw "${CMAKE_ARGV${_i}}")
    elseif (CMAKE_ARGV${_i} STREQUAL "--")
        set(_seen_dashdash TRUE)
    endif ()
endforeach ()

set(_cli_command "")
set(_cli_args "")
set(_cli_packages "")
set(_cli_algo SHA256)
set(_cli_git "")
set(_cli_defines "")
set(_pending "")
foreach (_a IN LISTS _cli_raw)
    if (_pending)
        if (_pending STREQUAL "packages")
            set(_cli_packages "${_a}")
        elseif (_pending STREQUAL "cache-dir")
            set(CMDEP_DIR "${_a}")
            get_filename_component(CMDEP_DIR "${CMDEP_DIR}" ABSOLUTE)
            list(APPEND _cli_defines "-DCMDEP_DIR=${CMDEP_DIR}")
        elseif (_pending STREQUAL "project")
            set(CMDEP_PROJECT "${_a}")
            list(APPEND _cli_defines "-DCMDEP_PROJECT=${_a}")
        elseif (_pending STREQUAL "algo")
            string(TOUPPER "${_a}" _cli_algo)
        elseif (_pending STREQUAL "git")
            set(_cli_git "${_a}")
        elseif (_pending STREQUAL "older-than")
            set(CMDEP_GC_OLDER_THAN "${_a}")
        elseif (_pending STREQUAL "max-size")
            set(CMDEP_GC_MAX_SIZE "${_a}")
        endif ()
        set(_pending "")
    elseif (_a MATCHES "^--(packages|cache-dir|project|algo|git|older-than|max-size)$")
        set(_pending "${CMAKE_MATCH_1}")
    elseif (_a MATCHES "^--(packages|cache-dir|project|algo|git|older-than|max-size)=(.*)$")
        set(_pending "${CMAKE_MATCH_1}")
        set(_v "${CMAKE_MATCH_2}")
        # re-run the value branch
        if (_pending STREQUAL "packages")
            set(_cli_packages "${_v}")
        elseif (_pending STREQUAL "cache-dir")
            get_filename_component(CMDEP_DIR "${_v}" ABSOLUTE)
            list(APPEND _cli_defines "-DCMDEP_DIR=${CMDEP_DIR}")
        elseif (_pending STREQUAL "project")
            set(CMDEP_PROJECT "${_v}")
            list(APPEND _cli_defines "-DCMDEP_PROJECT=${_v}")
        elseif (_pending STREQUAL "algo")
            string(TOUPPER "${_v}" _cli_algo)
        elseif (_pending STREQUAL "git")
            set(_cli_git "${_v}")
        elseif (_pending STREQUAL "older-than")
            set(CMDEP_GC_OLDER_THAN "${_v}")
        elseif (_pending STREQUAL "max-size")
            set(CMDEP_GC_MAX_SIZE "${_v}")
        endif ()
        set(_pending "")
    elseif (_a STREQUAL "--dry-run")
        set(CMDEP_GC_DRY_RUN ON)
    elseif (_a MATCHES "^-D([A-Za-z_][A-Za-z0-9_]*)=(.*)$")
        set(${CMAKE_MATCH_1} "${CMAKE_MATCH_2}")
        list(APPEND _cli_defines "${_a}")
    elseif (_a MATCHES "^(-h|--help|help)$" AND NOT _cli_command)
        set(_cli_command help)
    elseif (_a MATCHES "^-")
        message(FATAL_ERROR "cmdep: unknown option '${_a}' (see `cmdep help`)")
    elseif (NOT _cli_command)
        set(_cli_command "${_a}")
    else ()
        list(APPEND _cli_args "${_a}")
    endif ()
endforeach ()
if (_pending)
    message(FATAL_ERROR "cmdep: --${_pending} needs a value")
endif ()
list(LENGTH _cli_args _cli_args_count)
if (_cli_packages)
    get_filename_component(_cli_packages "${_cli_packages}" ABSOLUTE)
endif ()
set(CMDEP_PROJECT_ROOT "${CMAKE_CURRENT_SOURCE_DIR}")

if (_cli_command STREQUAL "" OR _cli_command STREQUAL "help")
    _CmDepUsage()
elseif (_cli_command STREQUAL "add")
    _CmDepCliAdd()
elseif (_cli_command STREQUAL "hash")
    _CmDepCliHash()
elseif (_cli_command STREQUAL "fetch")
    _CmDepCliFetch()
elseif (_cli_command STREQUAL "mirror")
    _CmDepCliMirror()
elseif (_cli_command STREQUAL "push-binary")
    _CmDepCliPushBinary()
elseif (_cli_command STREQUAL "status")
    CmDepCacheStatus()
elseif (_cli_command STREQUAL "gc")
    CmDepCacheGc()
elseif (_cli_command STREQUAL "verify")
    CmDepCacheVerify()
elseif (_cli_command STREQUAL "cache-dir")
    CmDepCacheDir(_d)
    _CmDepOut("${_d}")
elseif (COMMAND _CmDepCli_${_cli_command})
    cmake_language(CALL _CmDepCli_${_cli_command})
else ()
    _CmDepUsage()
    message(FATAL_ERROR "cmdep: unknown command '${_cli_command}'")
endif ()
