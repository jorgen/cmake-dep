# Inspect and clean the cmake-dep cache (script mode).
#
#   cmake -DCMDEP_CACHE_ACTION=status -P CmDepCache.cmake
#   cmake -DCMDEP_CACHE_ACTION=gc [-DCMDEP_GC_OLDER_THAN=30d] [-DCMDEP_GC_MAX_SIZE=20G]
#         [-DCMDEP_GC_DRY_RUN=ON] -P CmDepCache.cmake
#   cmake -DCMDEP_CACHE_ACTION=verify [-DCMDEP_GC_DRY_RUN=ON] -P CmDepCache.cmake
#
# Usually run through the `cmdep` command: `cmdep status`, `cmdep gc`, `cmdep verify`.
#
# "Last used" is the mtime of an entry's completion stamp (or of an archive),
# refreshed at most once a day whenever a configure uses it.
#
# gc always removes abandoned temp dirs (> 1 day old) and incomplete entries
# (> 1 hour old), then entries/archives unused for longer than
# CMDEP_GC_OLDER_THAN (default 90d), then -- if CMDEP_GC_MAX_SIZE is set -- the
# least recently used ones until the cache fits. Entries locked by a running
# configure are skipped. Deleting an entry that a build tree still uses only
# costs a re-fetch or rebuild at its next configure.

include("${CMAKE_CURRENT_LIST_DIR}/CmDepFetch.cmake")

function(_CmDepFormatSize out_var bytes)
    if (bytes GREATER_EQUAL 1073741824)
        math(EXPR _w "${bytes} / 1073741824")
        math(EXPR _f "(${bytes} % 1073741824) * 10 / 1073741824")
        set(_s "${_w}.${_f} GiB")
    elseif (bytes GREATER_EQUAL 1048576)
        math(EXPR _w "${bytes} / 1048576")
        math(EXPR _f "(${bytes} % 1048576) * 10 / 1048576")
        set(_s "${_w}.${_f} MiB")
    elseif (bytes GREATER_EQUAL 1024)
        math(EXPR _w "${bytes} / 1024")
        set(_s "${_w} KiB")
    else ()
        set(_s "${bytes} B")
    endif ()
    set(${out_var} "${_s}" PARENT_SCOPE)
endfunction()

# "30d", "12h", "90m", "3600s", "2w" -> seconds
function(_CmDepParseDuration out_var text)
    if (NOT text MATCHES "^([0-9]+)([smhdw]?)$")
        message(FATAL_ERROR "cmake-dep: bad duration '${text}' (use e.g. 30d, 12h, 2w)")
    endif ()
    set(_n "${CMAKE_MATCH_1}")
    set(_mul 1)
    if (CMAKE_MATCH_2 STREQUAL "m")
        set(_mul 60)
    elseif (CMAKE_MATCH_2 STREQUAL "h")
        set(_mul 3600)
    elseif (CMAKE_MATCH_2 STREQUAL "d" OR CMAKE_MATCH_2 STREQUAL "")
        set(_mul 86400)
    elseif (CMAKE_MATCH_2 STREQUAL "w")
        set(_mul 604800)
    endif ()
    math(EXPR _s "${_n} * ${_mul}")
    set(${out_var} "${_s}" PARENT_SCOPE)
endfunction()

# "20G", "500M", "1T", "123456" (bytes) -> bytes
function(_CmDepParseSize out_var text)
    string(TOUPPER "${text}" text)
    if (NOT text MATCHES "^([0-9]+)([KMGT]?)I?B?$")
        message(FATAL_ERROR "cmake-dep: bad size '${text}' (use e.g. 500M, 20G)")
    endif ()
    set(_n "${CMAKE_MATCH_1}")
    set(_u "${CMAKE_MATCH_2}")
    set(_mul 1)
    if (_u STREQUAL "K")
        set(_mul 1024)
    elseif (_u STREQUAL "M")
        set(_mul 1048576)
    elseif (_u STREQUAL "G")
        set(_mul 1073741824)
    elseif (_u STREQUAL "T")
        set(_mul 1099511627776)
    endif ()
    math(EXPR _b "${_n} * ${_mul}")
    set(${out_var} "${_b}" PARENT_SCOPE)
endfunction()

function(_CmDepPathSize out_var path)
    if (NOT IS_DIRECTORY "${path}")
        file(SIZE "${path}" _total)
        set(${out_var} "${_total}" PARENT_SCOPE)
        return()
    endif ()
    set(_total 0)
    file(GLOB_RECURSE _files LIST_DIRECTORIES false "${path}/*")
    foreach (_f IN LISTS _files)
        if (NOT IS_SYMLINK "${_f}")
            file(SIZE "${_f}" _sz)
            math(EXPR _total "${_total} + ${_sz}")
        endif ()
    endforeach ()
    set(${out_var} "${_total}" PARENT_SCOPE)
endfunction()

# Lists cache entries as "<last-used padded>|<kind>|<path>|<size>|<lock name>"
# kinds: source, binary, archive, incomplete
function(_CmDepCacheEntries out_var root)
    set(_out "")
    set(_candidates "")
    file(GLOB _top LIST_DIRECTORIES true "${root}/*")
    foreach (_d IN LISTS _top)
        get_filename_component(_n "${_d}" NAME)
        if (IS_DIRECTORY "${_d}" AND NOT _n MATCHES "^(archives|bin|git|\\..*)$")
            list(APPEND _candidates "source|${_d}|${_n}")
        endif ()
    endforeach ()
    file(GLOB _bins LIST_DIRECTORIES true "${root}/bin/*")
    foreach (_d IN LISTS _bins)
        get_filename_component(_n "${_d}" NAME)
        if (IS_DIRECTORY "${_d}")
            list(APPEND _candidates "binary|${_d}|bin-${_n}")
        endif ()
    endforeach ()
    foreach (_c IN LISTS _candidates)
        string(REPLACE "|" ";" _parts "${_c}")
        list(GET _parts 0 _kind)
        list(GET _parts 1 _path)
        list(GET _parts 2 _lock)
        if (EXISTS "${_path}/.cmake-dep-complete")
            file(TIMESTAMP "${_path}/.cmake-dep-complete" _t "%s" UTC)
        else ()
            set(_kind incomplete)
            file(TIMESTAMP "${_path}" _t "%s" UTC)
        endif ()
        _CmDepPathSize(_sz "${_path}")
        string(LENGTH "${_t}" _l)
        while (_l LESS 12)
            set(_t "0${_t}")
            math(EXPR _l "${_l} + 1")
        endwhile ()
        list(APPEND _out "${_t}|${_kind}|${_path}|${_sz}|${_lock}")
    endforeach ()
    file(GLOB _archives LIST_DIRECTORIES false "${root}/archives/*/*")
    foreach (_a IN LISTS _archives)
        if (_a MATCHES "\\.part-")
            continue()
        endif ()
        file(TIMESTAMP "${_a}" _t "%s" UTC)
        file(SIZE "${_a}" _sz)
        string(LENGTH "${_t}" _l)
        while (_l LESS 12)
            set(_t "0${_t}")
            math(EXPR _l "${_l} + 1")
        endwhile ()
        list(APPEND _out "${_t}|archive|${_a}|${_sz}|")
    endforeach ()
    list(SORT _out)
    set(${out_var} "${_out}" PARENT_SCOPE)
endfunction()

# Removes <path> unless its lock is held by someone else. The entry is first
# renamed out of the way so it disappears atomically. Sets out_ok.
function(_CmDepCacheRemove out_ok root path lock dry_run)
    if (dry_run)
        set(${out_ok} TRUE PARENT_SCOPE)
        return()
    endif ()
    if (lock)
        file(MAKE_DIRECTORY "${root}/.locks")
        file(LOCK "${root}/.locks/${lock}.lock" GUARD FUNCTION TIMEOUT 0 RESULT_VARIABLE _r)
        if (NOT _r EQUAL 0)
            set(${out_ok} FALSE PARENT_SCOPE)
            return()
        endif ()
    endif ()
    file(MAKE_DIRECTORY "${root}/.tmp")
    string(RANDOM LENGTH 10 _rand)
    set(_trash "${root}/.tmp/gc-${_rand}")
    file(RENAME "${path}" "${_trash}")
    file(REMOVE_RECURSE "${_trash}")
    set(${out_ok} TRUE PARENT_SCOPE)
endfunction()

function(CmDepCacheStatus)
    CmDepCacheDir(_root)
    _CmDepCacheEntries(_entries "${_root}")
    string(TIMESTAMP _now "%s" UTC)
    set(_report "cmake-dep cache: ${_root}\n\n")
    string(APPEND _report "  KIND        SIZE        LAST USED   ENTRY\n")
    set(_total 0)
    set(_count 0)
    list(REVERSE _entries)  # most recently used first
    foreach (_e IN LISTS _entries)
        string(REPLACE "|" ";" _p "${_e}")
        list(GET _p 0 _t)
        list(GET _p 1 _kind)
        list(GET _p 2 _path)
        list(GET _p 3 _sz)
        math(EXPR _total "${_total} + ${_sz}")
        math(EXPR _count "${_count} + 1")
        math(EXPR _days "(${_now} - ${_t}) / 86400")
        _CmDepFormatSize(_fs "${_sz}")
        file(RELATIVE_PATH _rel "${_root}" "${_path}")
        set(_line "  ${_kind}")
        string(LENGTH "${_line}" _l)
        while (_l LESS 14)
            string(APPEND _line " ")
            math(EXPR _l "${_l} + 1")
        endwhile ()
        string(APPEND _line "${_fs}")
        string(LENGTH "${_line}" _l)
        while (_l LESS 26)
            string(APPEND _line " ")
            math(EXPR _l "${_l} + 1")
        endwhile ()
        string(APPEND _line "${_days}d ago")
        string(LENGTH "${_line}" _l)
        while (_l LESS 38)
            string(APPEND _line " ")
            math(EXPR _l "${_l} + 1")
        endwhile ()
        string(APPEND _report "${_line}${_rel}\n")
    endforeach ()
    _CmDepFormatSize(_ft "${_total}")
    string(APPEND _report "\n  ${_count} entries, ${_ft} total\n")
    execute_process(COMMAND ${CMAKE_COMMAND} -E echo "${_report}")
endfunction()

function(CmDepCacheGc)
    CmDepCacheDir(_root)
    if (NOT IS_DIRECTORY "${_root}")
        execute_process(COMMAND ${CMAKE_COMMAND} -E echo "cmake-dep cache ${_root} does not exist")
        return()
    endif ()
    if (CMDEP_GC_OLDER_THAN)
        _CmDepParseDuration(_max_age "${CMDEP_GC_OLDER_THAN}")
    else ()
        _CmDepParseDuration(_max_age 90d)
    endif ()
    set(_max_size "")
    if (CMDEP_GC_MAX_SIZE)
        _CmDepParseSize(_max_size "${CMDEP_GC_MAX_SIZE}")
    endif ()
    set(_dry FALSE)
    if (CMDEP_GC_DRY_RUN)
        set(_dry TRUE)
    endif ()
    string(TIMESTAMP _now "%s" UTC)
    set(_report "")
    set(_freed 0)
    set(_removed 0)

    # 1. abandoned temp dirs
    file(GLOB _tmps LIST_DIRECTORIES true "${_root}/.tmp/*")
    foreach (_t IN LISTS _tmps)
        file(TIMESTAMP "${_t}" _ts "%s" UTC)
        math(EXPR _age "${_now} - ${_ts}")
        if (_age LESS 86400)
            continue()
        endif ()
        get_filename_component(_n "${_t}" NAME)
        set(_lock "${_n}")
        if (_n MATCHES "^(gc|push)-")
            set(_lock "")
        endif ()
        _CmDepPathSize(_sz "${_t}")
        _CmDepCacheRemove(_ok "${_root}" "${_t}" "${_lock}" ${_dry})
        if (_ok)
            math(EXPR _freed "${_freed} + ${_sz}")
            math(EXPR _removed "${_removed} + 1")
            string(APPEND _report "  removed temp dir .tmp/${_n}\n")
        endif ()
    endforeach ()

    # 2./3. incomplete and unused entries
    _CmDepCacheEntries(_entries "${_root}")
    set(_kept "")
    set(_total 0)
    foreach (_e IN LISTS _entries)
        string(REPLACE "|" ";" _p "${_e}")
        list(GET _p 0 _t)
        list(GET _p 1 _kind)
        list(GET _p 2 _path)
        list(GET _p 3 _sz)
        list(LENGTH _p _np)
        set(_lock "")
        if (_np GREATER 4)
            list(GET _p 4 _lock)
        endif ()
        math(EXPR _age "${_now} - ${_t}")
        set(_why "")
        if (_kind STREQUAL "incomplete" AND _age GREATER 3600)
            set(_why "incomplete")
        elseif (NOT _kind STREQUAL "incomplete" AND _age GREATER _max_age)
            math(EXPR _days "${_age} / 86400")
            set(_why "unused for ${_days}d")
        endif ()
        if (_why)
            _CmDepCacheRemove(_ok "${_root}" "${_path}" "${_lock}" ${_dry})
            if (_ok)
                file(RELATIVE_PATH _rel "${_root}" "${_path}")
                _CmDepFormatSize(_fs "${_sz}")
                string(APPEND _report "  removed ${_rel} (${_why}, ${_fs})\n")
                math(EXPR _freed "${_freed} + ${_sz}")
                math(EXPR _removed "${_removed} + 1")
                continue()
            endif ()
        endif ()
        list(APPEND _kept "${_e}")
        math(EXPR _total "${_total} + ${_sz}")
    endforeach ()

    # 4. size limit: least recently used first (entries are sorted by last use)
    if (_max_size)
        foreach (_e IN LISTS _kept)
            if (NOT _total GREATER _max_size)
                break()
            endif ()
            string(REPLACE "|" ";" _p "${_e}")
            list(GET _p 0 _t)
            list(GET _p 1 _kind)
            list(GET _p 2 _path)
            list(GET _p 3 _sz)
            list(LENGTH _p _np)
            set(_lock "")
            if (_np GREATER 4)
                list(GET _p 4 _lock)
            endif ()
            math(EXPR _age "${_now} - ${_t}")
            if (_kind STREQUAL "archive" AND _age LESS 3600)
                continue()  # may be mid-extraction by a running configure
            endif ()
            _CmDepCacheRemove(_ok "${_root}" "${_path}" "${_lock}" ${_dry})
            if (_ok)
                file(RELATIVE_PATH _rel "${_root}" "${_path}")
                _CmDepFormatSize(_fs "${_sz}")
                string(APPEND _report "  removed ${_rel} (over size limit, ${_fs})\n")
                math(EXPR _freed "${_freed} + ${_sz}")
                math(EXPR _total "${_total} - ${_sz}")
                math(EXPR _removed "${_removed} + 1")
            endif ()
        endforeach ()
    endif ()

    _CmDepFormatSize(_ff "${_freed}")
    _CmDepFormatSize(_ft "${_total}")
    if (_dry)
        set(_head "cmake-dep gc (dry run, nothing deleted): ${_root}\n")
        set(_tail "\n  would remove ${_removed} item(s), freeing ${_ff}; ${_ft} would remain\n")
    else ()
        set(_head "cmake-dep gc: ${_root}\n")
        set(_tail "\n  removed ${_removed} item(s), freed ${_ff}; ${_ft} remains\n")
    endif ()
    execute_process(COMMAND ${CMAKE_COMMAND} -E echo "${_head}${_report}${_tail}")
endfunction()

function(CmDepCacheVerify)
    CmDepCacheDir(_root)
    set(_dry FALSE)
    if (CMDEP_GC_DRY_RUN)
        set(_dry TRUE)
    endif ()
    set(_report "cmake-dep verify: ${_root}\n")
    set(_bad 0)
    set(_ok_count 0)
    file(GLOB _algos LIST_DIRECTORIES true "${_root}/archives/*")
    foreach (_ad IN LISTS _algos)
        get_filename_component(_adir "${_ad}" NAME)
        string(TOUPPER "${_adir}" _algo)
        file(GLOB _files LIST_DIRECTORIES false "${_ad}/*")
        foreach (_f IN LISTS _files)
            get_filename_component(_hex "${_f}" NAME)
            if (_hex MATCHES "\\.part-")
                continue()
            endif ()
            file(${_algo} "${_f}" _actual)
            if (_actual STREQUAL _hex)
                math(EXPR _ok_count "${_ok_count} + 1")
            else ()
                math(EXPR _bad "${_bad} + 1")
                string(APPEND _report "  CORRUPT archives/${_adir}/${_hex}")
                if (NOT _dry)
                    file(REMOVE "${_f}")
                    string(APPEND _report " (removed; re-fetched on next use)")
                endif ()
                string(APPEND _report "\n")
            endif ()
        endforeach ()
    endforeach ()
    _CmDepCacheEntries(_entries "${_root}")
    foreach (_e IN LISTS _entries)
        string(REPLACE "|" ";" _p "${_e}")
        list(GET _p 1 _kind)
        list(GET _p 2 _path)
        file(RELATIVE_PATH _rel "${_root}" "${_path}")
        if (_kind STREQUAL "incomplete")
            math(EXPR _bad "${_bad} + 1")
            string(APPEND _report "  INCOMPLETE ${_rel} (no stamp; removed by `cmdep gc`, or re-fetched on next use)\n")
        elseif (_kind STREQUAL "binary" AND NOT EXISTS "${_path}/.cmake-dep-binary.txt")
            math(EXPR _bad "${_bad} + 1")
            string(APPEND _report "  BROKEN ${_rel} (binary package without build manifest)\n")
        endif ()
    endforeach ()
    string(APPEND _report "\n  ${_ok_count} archive(s) verified, ${_bad} problem(s)\n")
    execute_process(COMMAND ${CMAKE_COMMAND} -E echo "${_report}")
endfunction()

if (CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
    if (CMDEP_CACHE_ACTION STREQUAL "status")
        CmDepCacheStatus()
    elseif (CMDEP_CACHE_ACTION STREQUAL "gc")
        CmDepCacheGc()
    elseif (CMDEP_CACHE_ACTION STREQUAL "verify")
        CmDepCacheVerify()
    else ()
        message(FATAL_ERROR "usage: cmake -DCMDEP_CACHE_ACTION=status|gc|verify -P CmDepCache.cmake")
    endif ()
endif ()
