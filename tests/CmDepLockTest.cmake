# Tests for transitive dependencies: the per-build registry, cmdep lock,
# cmdep.lock at configure time, cmdep tree. Run with:
#   cmake -P tests/CmDepLockTest.cmake   (also run by CmDepFetchTest.cmake; needs git for patches)
cmake_minimum_required(VERSION 3.18)

get_filename_component(_repo "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if (NOT WORK_DIR)
    set(WORK_DIR "${CMAKE_CURRENT_BINARY_DIR}/cmdep-lock-test-work")
endif ()
file(TO_CMAKE_PATH "${WORK_DIR}" WORK_DIR)
file(REMOVE_RECURSE "${WORK_DIR}")
file(MAKE_DIRECTORY "${WORK_DIR}")
set(CACHE_DIR "${WORK_DIR}/cache")
include("${CMAKE_CURRENT_LIST_DIR}/CmDepTestHelpers.cmake")
if (RESULT_FILE)
    file(WRITE "${RESULT_FILE}" "1")
endif ()
if (WIN32)
    set(CMDEP "${_repo}/bin/cmdep.cmd")
else ()
    set(CMDEP "${_repo}/bin/cmdep")
endif ()

# make_pkg(<out_hash_var> <dir name> <relpath> <content> [<relpath> <content>]...)
function(make_pkg out_hash top)
    set(_src "${WORK_DIR}/src/${top}")
    file(REMOVE_RECURSE "${_src}")
    set(_args ${ARGN})
    list(LENGTH _args _n)
    math(EXPR _last "${_n} - 1")
    foreach (_i RANGE 0 ${_last} 2)
        math(EXPR _j "${_i} + 1")
        list(GET _args ${_i} _rel)
        list(GET _args ${_j} _content)
        file(WRITE "${_src}/${_rel}" "${_content}")
    endforeach ()
    execute_process(COMMAND ${CMAKE_COMMAND} -E tar czf "${WORK_DIR}/${top}.tar.gz" "${top}"
        WORKING_DIRECTORY "${WORK_DIR}/src")
    file(SHA256 "${WORK_DIR}/${top}.tar.gz" _h)
    set(${out_hash} "${_h}" PARENT_SCOPE)
endfunction()
function(pkg_line out name version hash)
    string(REPLACE ";" " " _extra "${ARGN}")
    set(${out} "CmDepFetchPackage(${name} ${version} \"${FU}${WORK_DIR}/${name}-${version}.tar.gz\" SHA256=${hash} ${_extra})\n" PARENT_SCOPE)
endfunction()

# --- fixture graph ---------------------------------------------------------------
make_pkg(HZ12 zlib-1.2 CMakeLists.txt "add_library(zlib INTERFACE)\nset_property(GLOBAL APPEND PROPERTY ZLIB_SEEN 1.2)\n")
make_pkg(HZ13 zlib-1.3 CMakeLists.txt "add_library(zlib INTERFACE)\nset_property(GLOBAL APPEND PROPERTY ZLIB_SEEN 1.3)\n")
make_pkg(HCOM common-1.0 CMakeLists.txt "add_library(common INTERFACE)\n")
make_pkg(HPAT pat-1.0 CMakeLists.txt "set_property(GLOBAL PROPERTY PAT_VALUE original)\n")
pkg_line(L_Z12 zlib 1.2 ${HZ12})
pkg_line(L_Z13 zlib 1.3 ${HZ13})
pkg_line(L_COM common 1.0 ${HCOM})
pkg_line(L_PAT pat 1.0 ${HPAT} PATCHES patches/pat.patch)
set(NESTED_CML "cmake_minimum_required(VERSION 3.18)\nproject(@N@ NONE)\nset(CMDEP_PACKAGES_FILE \"\${CMAKE_CURRENT_SOURCE_DIR}/@PF@\")\nCmDepFetch()\n@ADDS@add_library(@N@ INTERFACE)\n")
string(REPLACE "@N@" libA _a "${NESTED_CML}")
string(REPLACE "@PF@" cmdep-packages.cmake _a "${_a}")
string(REPLACE "@ADDS@" "CmDepAddPackage(zlib)\nCmDepAddPackage(common)\n" _a "${_a}")
make_pkg(HA libA-1.0 CMakeLists.txt "${_a}" cmdep-packages.cmake "${L_Z12}${L_COM}")
string(REPLACE "@N@" libB _b "${NESTED_CML}")
string(REPLACE "@PF@" CMake/3rdPartyPackages.cmake _b "${_b}")
string(REPLACE "@ADDS@" "CmDepAddPackage(zlib)\ninclude(\"\${pat_SOURCE_DIR}/CMakeLists.txt\")\n" _b "${_b}")
make_pkg(HB libB-1.0 CMakeLists.txt "${_b}" CMake/3rdPartyPackages.cmake "${L_Z13}${L_PAT}"
    CMake/patches/pat.patch "--- a/CMakeLists.txt\n+++ b/CMakeLists.txt\n@@ -1 +1 @@\n-set_property(GLOBAL PROPERTY PAT_VALUE original)\n+set_property(GLOBAL PROPERTY PAT_VALUE patched)\n")
pkg_line(L_A libA 1.0 ${HA})
pkg_line(L_B libB 1.0 ${HB})

set(ROOT "${WORK_DIR}/root")
file(MAKE_DIRECTORY "${ROOT}")
file(WRITE "${ROOT}/cmdep-packages.cmake" "${L_A}${L_B}")
file(WRITE "${ROOT}/CMakeLists.txt" "
cmake_minimum_required(VERSION 3.18)
project(root NONE)
list(APPEND CMAKE_MODULE_PATH \"${_repo}/cmake\")
include(CmDepMain)
CmDepFetch()
CmDepAddPackage(libA)
CmDepAddPackage(libB)
get_property(_z GLOBAL PROPERTY ZLIB_SEEN)
get_property(_p GLOBAL PROPERTY PAT_VALUE)
file(WRITE \"\${CMAKE_BINARY_DIR}/result.txt\" \"zlib=\${_z};pat=\${_p}\")
")

function(cmdep out_rc out_log)
    execute_process(
        COMMAND ${CMAKE_COMMAND} -E env --unset=CMDEP_MIRRORS --unset=CMDEP_PACKAGES_FILE
                CMDEP_CONFIG=${WORK_DIR}/no-such-config.cmake CMDEP_DIR=${CACHE_DIR}
                CMAKE=${CMAKE_COMMAND} "${CMDEP}" ${ARGN}
        WORKING_DIRECTORY "${ROOT}" RESULT_VARIABLE _rc OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
    set(${out_rc} "${_rc}" PARENT_SCOPE)
    set(${out_log} "${_out}${_err}" PARENT_SCOPE)
endfunction()
function(configure_root out_rc out_log out_result bdir)
    file(REMOVE_RECURSE "${bdir}")
    execute_process(
        COMMAND ${CMAKE_COMMAND} -E env CMDEP_CONFIG=${WORK_DIR}/no-such-config.cmake --unset=CMDEP_MIRRORS
                ${CMAKE_COMMAND} -S "${ROOT}" -B "${bdir}" -DCMDEP_DIR=${CACHE_DIR} ${ARGN}
        RESULT_VARIABLE _rc OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
    set(_res "")
    if (EXISTS "${bdir}/result.txt")
        file(READ "${bdir}/result.txt" _res)
    endif ()
    set(${out_rc} "${_rc}" PARENT_SCOPE)
    set(${out_log} "${_out}${_err}" PARENT_SCOPE)
    set(${out_result} "${_res}" PARENT_SCOPE)
endfunction()

# --- L1. no lockfile: one copy, first declaration wins ---------------------------------
configure_root(rc log res "${WORK_DIR}/b1")
string(FIND "${log}" "libB asks for 1.3; using 1.2" _uni)
check("rc EQUAL 0 AND res STREQUAL \"zlib=1.2;pat=patched\"" "without a lock: one zlib (first declaration, libA's 1.2), no duplicate targets")
check("NOT _uni EQUAL -1" "the unification is reported")

# --- L2. cmdep lock ---------------------------------------------------------------------
cmdep(rc log lock)
check("rc EQUAL 0 AND EXISTS \"${ROOT}/cmdep.lock\"" "cmdep lock writes cmdep.lock")
file(READ "${ROOT}/cmdep.lock" LOCK)
string(FIND "${LOCK}" "CmDepLocked(zlib\n    VERSION [==[1.3]==]" _z13)
string(FIND "${LOCK}" "[==[libA=1.2]==]" _wantA)
string(FIND "${LOCK}" "CmDepLocked(common" _com)
string(FIND "${LOCK}" "DECLARED_IN [==[CMake/3rdPartyPackages.cmake]==]" _din)
check("NOT _z13 EQUAL -1 AND NOT _wantA EQUAL -1" "highest requested zlib (1.3) is locked; libA's request recorded")
check("NOT _com EQUAL -1 AND NOT _din EQUAL -1" "transitive packages and where they were declared are recorded")
string(FIND "${LOCK}" "CmDepLocked(libA" _pa)
string(FIND "${LOCK}" "CmDepLocked(zlib" _pz)
check("_pa LESS _pz" "declarers come before what they declare")
string(FIND "${log}" "zlib: libA asks for 1.2, locked to 1.3" _note)
check("NOT _note EQUAL -1" "cmdep lock reports unified versions")

# --- L3. configure with the lock ----------------------------------------------------------
configure_root(rc log res "${WORK_DIR}/b3")
check("rc EQUAL 0 AND res STREQUAL \"zlib=1.3;pat=patched\"" "with the lock: everyone gets the locked zlib 1.3; libB's patch applied")

# --- L4. tree / --check ------------------------------------------------------------------------
cmdep(rc log tree)
string(FIND "${log}" "libA 1.0" _t1)
string(FIND "${log}" "zlib 1.3 (asks for 1.2)" _t2)
check("rc EQUAL 0 AND NOT _t1 EQUAL -1 AND NOT _t2 EQUAL -1" "cmdep tree shows the graph and unified requests")
cmdep(rc log lock --check)
check("rc EQUAL 0" "cmdep lock --check passes on a fresh lock")

# --- L5. root declaration wins --------------------------------------------------------------
file(WRITE "${ROOT}/cmdep-packages.cmake" "${L_A}${L_B}${L_Z12}")
cmdep(rc log lock --check)
check("NOT rc EQUAL 0" "lock --check fails after the packages file changed")
configure_root(rc log res "${WORK_DIR}/b5" -DCMDEP_LOCKED=ON)
check("NOT rc EQUAL 0" "CMDEP_LOCKED=ON: a stale lock fails the configure")
configure_root(rc log res "${WORK_DIR}/b5b")
string(FIND "${log}" "is out of date: zlib is 1.2" _ood)
check("rc EQUAL 0 AND NOT _ood EQUAL -1 AND res STREQUAL \"zlib=1.2;pat=patched\"" "stale lock: configure warns and follows the packages file")
cmdep(rc log lock)
file(READ "${ROOT}/cmdep.lock" LOCK)
string(FIND "${LOCK}" "CmDepLocked(zlib\n    VERSION [==[1.2]==]" _z12)
check("rc EQUAL 0 AND NOT _z12 EQUAL -1" "a root declaration overrides the highest version")
configure_root(rc log res "${WORK_DIR}/b5c")
check("rc EQUAL 0 AND res STREQUAL \"zlib=1.2;pat=patched\"" "configure follows the root's choice")

# --- L6. changed root declaration vs lock: warning ---------------------------------------------
file(WRITE "${ROOT}/cmdep-packages.cmake" "${L_A}${L_B}${L_Z13}")
configure_root(rc log res "${WORK_DIR}/b6")
string(FIND "${log}" "out of date" _ood)
check("rc EQUAL 0 AND NOT _ood EQUAL -1" "root declaration differing from the lock warns")
cmdep(rc log lock)

# --- L7. conflict: same version, different hashes ----------------------------------------------
make_pkg(HZ13B zlib-1.3b CMakeLists.txt "add_library(zlib INTERFACE) # other\n")
set(_bad_line "CmDepFetchPackage(zlib 1.3 \"${FU}${WORK_DIR}/zlib-1.3b.tar.gz\" SHA256=${HZ13B})\n")
string(REPLACE "@N@" libC _c "${NESTED_CML}")
string(REPLACE "@PF@" cmdep-packages.cmake _c "${_c}")
string(REPLACE "@ADDS@" "" _c "${_c}")
make_pkg(HC libC-1.0 CMakeLists.txt "${_c}" cmdep-packages.cmake "${_bad_line}")
pkg_line(L_C libC 1.0 ${HC})
file(WRITE "${ROOT}/cmdep-packages.cmake" "${L_A}${L_B}${L_C}")
cmdep(rc log lock)
string(FIND "${log}" "conflict for zlib 1.3" _conf)
check("NOT rc EQUAL 0 AND NOT _conf EQUAL -1" "same version with different hashes is a conflict")
file(WRITE "${ROOT}/cmdep-packages.cmake" "${L_A}${L_B}")
cmdep(rc log lock)

# --- L8. fetch / mirror cover the transitive graph; root USE_SYSTEM for a transitive dep ---------
file(REMOVE_RECURSE "${CACHE_DIR}")
cmdep(rc log fetch)
string(SUBSTRING "${HCOM}" 0 12 SC)
check("rc EQUAL 0 AND EXISTS \"${CACHE_DIR}/common-1.0-${SC}/.cmake-dep-complete\"" "cmdep fetch fetches locked transitive packages")
cmdep(rc log mirror "${WORK_DIR}/mirror")
check("rc EQUAL 0 AND EXISTS \"${WORK_DIR}/mirror/sha256/${HZ13}\" AND EXISTS \"${WORK_DIR}/mirror/sha256/${HPAT}\"" "cmdep mirror includes transitive packages")
file(REMOVE_RECURSE "${CACHE_DIR}")
cmdep(rc log --project root -DROOT_USE_SYSTEM_COMMON=ON fetch)
check("rc EQUAL 0 AND NOT EXISTS \"${CACHE_DIR}/common-1.0-${SC}\"" "the root's USE_SYSTEM knob applies to a transitive package")

if (RESULT_FILE)
    file(WRITE "${RESULT_FILE}" "${_failures}")
endif ()
if (_failures GREATER 0)
    message(FATAL_ERROR "${_failures} lock test(s) failed")
endif ()
message(STATUS "All lock tests passed")
